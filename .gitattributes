# Canonical generated documentation and its source template intentionally use
# Markdown hard breaks. All other tracked files keep Git's whitespace checks.
docs/scripts/reference.md -whitespace
scripts/templates/workspace-readme-template.md -whitespace

# Intake authoring binds the exact generated Markdown, whose metadata header
# intentionally uses hard breaks. / Intake-Authoring bindet das exakt erzeugte
# Markdown, dessen Metadatenkopf absichtlich Hardbreaks verwendet.
intakes/*.md -whitespace
specs/intake-authoring-archive/**/target.md -whitespace

# gitignore.io macOS requires literal CR bytes for the Finder Icon filename.
# gitignore.io macOS benoetigt echte CR-Bytes fuer den Finder-Dateinamen Icon.
.gitignore whitespace=-blank-at-eol
