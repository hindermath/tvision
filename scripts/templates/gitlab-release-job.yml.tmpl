# home-baseline gitlab release automation
release:
  stage: release
  image: ubuntu:24.04
  resource_group: release
  allow_failure: true
  before_script:
    - apt-get update -qq
    - apt-get install -y -qq bash curl git jq
  script:
    - bash scripts/release-gitlab.sh
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      when: manual
    - when: never
